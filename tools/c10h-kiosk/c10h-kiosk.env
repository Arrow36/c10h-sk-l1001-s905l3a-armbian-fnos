# ==============================================================================
# C10H Wayland Kiosk System Configuration
# ==============================================================================

# Dashboard URL to display
KIOSK_URL="http://127.0.0.1:5666"

# Wayland Cage Screen Rotation (-r rotates 90 deg clockwise to 1280x800 landscape)
ROTATION_ARGS="-r"

# ------------------------------------------------------------------------------
# Modular Kiosk & Touch Features (1 = Enabled, 0 = Disabled)
# ------------------------------------------------------------------------------
# 虚拟触控输入法 (Virtual Touch Keyboard with Chinese Pinyin / Xiaohe Shuangpin)
ENABLE_TOUCH_KEYBOARD=1

# 顶部网址导航栏与控制条 (Top Browser Navigation Bar)
ENABLE_BROWSER_NAV=1

# 触屏拖拽滑动 (Kinetic Touch Drag-to-Scroll)
ENABLE_TOUCH_SCROLL=1

# 默认中文输入模式 ("xiaohe" = 小鹤双拼, "quanpin" = 全拼)
DEFAULT_INPUT_MODE="xiaohe"
